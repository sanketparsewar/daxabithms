#!/bin/sh
set -e
systemctl daemon-reload >/dev/null 2>&1 || true
if [ "$1" = purge ]; then
  echo "daxabithms: your data stays in Docker volumes (daxabithms_pg_data, daxabithms_uploads_data, daxabithms_state) and your settings and generated passwords in /etc/daxabithms/daxabithms.env, so a later reinstall picks up where you left off. To delete everything for good: sudo docker compose --project-name daxabithms down -v ; sudo rm -rf /etc/daxabithms" >&2
fi
exit 0
