#!/bin/sh
set -e
ENVF=/etc/daxabithms/daxabithms.env
if [ "$1" = configure ]; then
  # First install: create the settings file from the shipped example. It is never overwritten or removed by apt.
  if [ ! -f "$ENVF" ]; then
    install -d -m 0755 /etc/daxabithms
    install -m 0600 /usr/share/daxabithms/daxabithms.env.example "$ENVF"
  fi
  # Replace every @SECRET@ with a fresh random value (only a new file has any).
  if grep -q '@SECRET@' "$ENVF" 2>/dev/null; then
    tmp=$(mktemp)
    while IFS= read -r line; do
      case "$line" in
        *@SECRET@*) s=$(head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n'); printf '%s\n' "${line%%@SECRET@*}$s${line#*@SECRET@}" ;;
        *) printf '%s\n' "$line" ;;
      esac
    done < "$ENVF" > "$tmp"
    cat "$tmp" > "$ENVF"; rm -f "$tmp"
  fi
  chmod 0600 "$ENVF"
  IMAGE_BUNDLE=/usr/lib/daxabithms/container-images.tar.gz
  if [ -r "$IMAGE_BUNDLE" ] && command -v docker >/dev/null 2>&1; then
    systemctl start docker.service >/dev/null 2>&1 || true
    if docker info >/dev/null 2>&1; then
      docker load --input "$IMAGE_BUNDLE" >/dev/null || \
        echo "daxabithms: bundled images could not be loaded; the service will try to pull them when it starts." >&2
    else
      echo "daxabithms: Docker is not ready to load bundled images; the service will try to pull them when it starts." >&2
    fi
  fi
  systemctl daemon-reload >/dev/null 2>&1 || true
  systemctl enable daxabithms.service >/dev/null 2>&1 || true
  if [ -d /run/systemd/system ]; then
    # Start the local application; do not fail package installation if Docker is not ready.
    systemctl restart daxabithms.service >/dev/null 2>&1 || \
      echo "daxabithms: could not start yet; check Docker, then run: sudo systemctl start daxabithms" >&2
  fi
  echo "DaxabitHMS is installed. Launch it from the Applications menu."
fi
exit 0
