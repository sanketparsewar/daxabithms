# Desktop-only DaxabitHMS settings. Restart after editing: sudo systemctl restart daxabithms
POSTGRES_PASSWORD=@SECRET@
HOST_PORT=1995
# Local desktop origin only. Do not change this to a LAN address or public domain.
FRONTEND_ORIGIN=http://127.0.0.1:1995
# Set true only behind real HTTPS (otherwise login breaks).
COOKIE_SECURE=false
