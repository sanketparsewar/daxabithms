# ==============================================================================
# DaxabitHMS Backend Environment Configuration
# ==============================================================================

# Database Connection (PostgreSQL 15+)
DATABASE_URL="postgresql://daxabithms:daxabithms_dev_pw@localhost:5432/daxabithms"
# Optional connection pool tuning
DATABASE_CONNECTION_LIMIT=20
DATABASE_POOL_TIMEOUT=30

# Authentication & Security
# WARNING: Change to a strong random 32+ character secret in production!
JWT_SECRET="change-me-to-a-very-long-random-string-in-production"
JWT_EXPIRES_IN="12h"
# Set to "true" only when serving over HTTPS/TLS (enables Secure cookie flag)
COOKIE_SECURE="false"

# Server Network Settings
PORT=4000
CORS_ORIGIN="http://localhost:1995"
TRUST_PROXY="false"
# Rate limiting (max requests per minute per IP)
RATE_LIMIT_MAX=120
# Swagger API docs toggle (/docs)
ENABLE_SWAGGER="true"

# Local File Storage
UPLOADS_DIR="/data/uploads"

# Automated Database Backup & S3 Offsite Sync (Optional)
BACKUP_LOCAL_DIR="/data/backups"
BACKUP_ENCRYPTION_KEY=""
# S3_BACKUP_ENDPOINT="https://s3.example.com"
# S3_BACKUP_BUCKET="daxabithms-backups"
# S3_BACKUP_ACCESS_KEY_ID=""
# S3_BACKUP_SECRET_ACCESS_KEY=""
# S3_BACKUP_REGION="auto"
# S3_BACKUP_INTERVAL_DAYS="1"
# S3_BACKUP_RETAIN_COUNT="7"

# Multi-Branch Server Synchronization (Optional LAN / Cloud Hub)
# SYNC_API_KEY=""

# Container Self-Update Sidecar (Optional, used with docker-compose updater service)
# UPDATER_URL="http://updater:8080"
# UPDATER_TOKEN="daxabithms-updater"

# Spain Fiscal Compliance - VERI*FACTU (Optional)
# VERIFACTU_PRODUCER_ID=""
# VERIFACTU_PRODUCER_NAME=""
# VERIFACTU_PRODUCER_COUNTRY="ES"
# VERIFACTU_SYSTEM_ID=""
