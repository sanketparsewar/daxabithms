# ==============================================================================
# DaxabitHMS Docker Compose Environment Configuration
# ==============================================================================
# Copy this file to .env before running `docker compose up -d`.
# Compose reads .env from this directory automatically.
# NEVER commit the real .env file with secrets into version control.

# --- Database Credentials ---
POSTGRES_USER=daxabithms
POSTGRES_PASSWORD=change-me-to-a-secure-database-password
POSTGRES_DB=daxabithms

# --- Authentication & Session Security ---
# REQUIRED: Generate with `openssl rand -hex 32` or a 40+ random character string.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# --- Network & Host Port ---
# Port exposed on the host machine to access the web frontend and API proxy
HOST_PORT=1995
FRONTEND_ORIGIN=http://localhost:1995

# Set to "true" ONLY when this app is served over HTTPS (reverse proxy, Cloudflare Tunnel, SSL cert).
# When "false", works over plain HTTP (LAN IP or localhost) without breaking session cookies.
COOKIE_SECURE=false

# --- Application Version & Tag ---
APP_VERSION=dev

# --- Server Sync Hub (Optional) ---
# Makes this server a sync hub that secondary Windows/LAN installs can two-way sync with.
# SYNC_API_KEY=

# --- Spain VERI*FACTU Fiscal Compliance (Optional) ---
# VERIFACTU_PRODUCER_ID=
# VERIFACTU_PRODUCER_NAME=
# VERIFACTU_PRODUCER_COUNTRY=ES
# VERIFACTU_SYSTEM_ID=

# --- Automated Backup to S3-Compatible Storage (Optional) ---
# S3_BACKUP_ENDPOINT=https://s3.example.com
# S3_BACKUP_BUCKET=daxabithms-backups
# S3_BACKUP_ACCESS_KEY_ID=
# S3_BACKUP_SECRET_ACCESS_KEY=
# S3_BACKUP_REGION=auto
# S3_BACKUP_INTERVAL_DAYS=1
# S3_BACKUP_RETAIN_COUNT=7

# --- In-App Updates Sidecar ---
UPDATER_TOKEN=daxabithms-updater
